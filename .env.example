# Copy to .env.local and fill in. .env.local is gitignored. Never commit a real key.
GEMINI_API_KEY=
CHAT_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-2

PORT=8787
# Sites allowed to embed the widget iframe (CSP frame-ancestors)
ALLOWED_ORIGINS=https://www.accez.cloud,https://accez.cloud,http://localhost:3000
DATA_DIR=data
# Set true only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# Leads are always stored locally. Sending to Salesforce stays OFF until you switch it on.
SALESFORCE_ENABLED=false
# Public ids, the same ones the website's web-to-lead form already uses
SF_OID=00D41000002kA0p
SF_RECORD_TYPE=012Pm000004jdap

RETENTION_DAYS=90
DAILY_LLM_BUDGET=2000
MIN_SCORE=0.5
TOP_K=6
